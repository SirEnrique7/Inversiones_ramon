# ══════════════════════════════════════════════════════════════
# .env.example — Variables de entorno para Inversiones Ramón
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el .env real al control de versiones.
# ══════════════════════════════════════════════════════════════


# ─── Entorno ─────────────────────────────────────────────────
# DJANGO_ENV=production activa AUTOMÁTICAMENTE inversiones_ramon.settings_prod
# (HTTPS forzado, cookies seguras, CSRF_TRUSTED_ORIGINS, logging a archivo,
# etc.) — no se necesita configurar nada más por separado en systemd.
# En desarrollo, dejar SIN definir o en "development".
# DJANGO_ENV=production


# ─── Seguridad ───────────────────────────────────────────────
SECRET_KEY=django-insecure-dev-key-CAMBIAR-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# ─── Producción (settings_prod) ───────────────────────────────
# En producción, ALLOWED_HOSTS debe listar el/los dominios reales:
#   ALLOWED_HOSTS=inversionesramon.com,www.inversionesramon.com
#
# CSRF_TRUSTED_ORIGINS: igual que ALLOWED_HOSTS pero CON esquema
# (https://). Obligatorio en Django 4+ para que los formularios
# funcionen en producción:
#   CSRF_TRUSTED_ORIGINS=https://inversionesramon.com,https://www.inversionesramon.com
CSRF_TRUSTED_ORIGINS=
#
# BEHIND_PROXY: dejar en True (por defecto) si gunicorn corre
# detrás de Nginx/Apache con TLS (caso normal). Cambiar a False
# SOLO si gunicorn recibe tráfico HTTPS directo de internet sin
# proxy delante. Ver comentarios en settings_prod.py.
# BEHIND_PROXY=True


# ─── Base de datos PostgreSQL (obligatorio) ───────────────────
# DB_NAME, DB_USER y DB_PASSWORD son obligatorios — sin ellos el
# sistema no arranca (PostgreSQL es el único motor soportado).
DB_NAME=inversiones_ramon
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60


# ─── Email ────────────────────────────────────────────────────
# En desarrollo se usa el backend de consola (no se necesita configurar).
# En producción descomentar y completar:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu@email.com
# EMAIL_HOST_PASSWORD=tu_app_password
# DEFAULT_FROM_EMAIL=Inversiones Ramón <no-reply@inversionesramon.com>
